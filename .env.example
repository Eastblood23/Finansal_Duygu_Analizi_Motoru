# Copy to .env. Never commit real credentials.
DEBUG=false
UPDATE_INTERVAL_MINUTES=15
# Generate an independent random value (at least 32 characters).
JWT_SECRET_KEY=

POSTGRES_USER=finans_user
# Existing databases: use the existing password; this setting does not reset it.
POSTGRES_PASSWORD=
POSTGRES_DB=finans_db
# Docker Compose overrides HOST and REDIS_URL for the API container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1
DB_TIMEOUT_SECONDS=3
REQUEST_TIMEOUT_SECONDS=5

# Registration requires an authenticated TLS sender. Existing users can still log in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=finansalduygumotoru@gmail.com
# Google app password, not the normal Gmail password. Never commit it.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=finansalduygumotoru@gmail.com

NEWS_API_KEY=
FINNHUB_API_KEY=
GEMINI_API_KEY=
# Use an explicit supported model rather than a moving "latest" alias.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
